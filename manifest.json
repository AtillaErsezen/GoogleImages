{
    "manifest_version": 3,
    "name": "One-Click Image Downloader",
    "version": "1.0",
    "description": "Toggle on to instantly download images on right-click without a popup.",
    "permissions": [
        "downloads",
        "storage"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "Downloader Settings"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ]
        }
    ]
}